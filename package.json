{
  "name": "suluu-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Animated React components, available through a shadcn-compatible registry and npm.",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "pnpm build:package && pnpm registry:generate && pnpm --filter @suluu/www dev",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build:package": "pnpm --filter suluu build",
    "registry:generate": "pnpm --filter @suluu/registry generate",
    "registry:check": "pnpm --filter @suluu/registry check",
    "test:install": "pnpm --filter @suluu/registry test:install && pnpm --filter suluu test:install",
    "build:docs": "pnpm build:package && pnpm registry:generate && pnpm --filter @suluu/www build",
    "build": "pnpm build:package && pnpm registry:generate && pnpm --filter @suluu/www build",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build:package && pnpm registry:check && pnpm test:install && pnpm build:docs"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "latest",
    "@eslint/js": "^9.0.0",
    "@next/eslint-plugin-next": "latest",
    "@tailwindcss/postcss": "latest",
    "@testing-library/dom": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@testing-library/user-event": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/serve-handler": "latest",
    "@vitest/coverage-v8": "latest",
    "eslint": "^9.0.0",
    "eslint-plugin-jsx-a11y": "latest",
    "eslint-plugin-react-hooks": "latest",
    "globals": "latest",
    "jsdom": "latest",
    "motion": "^13.1.0",
    "next": "^16.3.1",
    "prettier": "latest",
    "prettier-plugin-tailwindcss": "latest",
    "publint": "latest",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "serve-handler": "latest",
    "shadcn": "latest",
    "tailwindcss": "^4.3.3",
    "tsdown": "latest",
    "tsx": "latest",
    "typescript": "^6.0.0",
    "typescript-eslint": "latest",
    "vitest": "latest",
    "vitest-axe": "latest"
  }
}
