{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "types": ["node", "vitest/globals", "@testing-library/jest-dom"],
    "paths": {
      "@/*": ["./*"],
      "suluu": ["../../packages/suluu/src/index.ts"],
      "suluu/counter-numbers": [
        "../../packages/suluu/src/counter-numbers/index.ts"
      ],
      "suluu/email-morph": ["../../packages/suluu/src/email-morph/index.ts"],
      "suluu/fluid-tabs": ["../../packages/suluu/src/fluid-tabs/index.ts"],
      "suluu/magnet-pull": ["../../packages/suluu/src/magnet-pull/index.ts"],
      "suluu/morph-button": ["../../packages/suluu/src/morph-button/index.ts"],
      "suluu/notify-morph": ["../../packages/suluu/src/notify-morph/index.ts"],
      "suluu/otp-input": ["../../packages/suluu/src/otp-input/index.ts"],
      "suluu/rope-time-picker": [
        "../../packages/suluu/src/rope-time-picker/index.ts"
      ],
      "suluu/search-morph": ["../../packages/suluu/src/search-morph/index.ts"],
      "suluu/segmented-control": [
        "../../packages/suluu/src/segmented-control/index.ts"
      ],
      "suluu/slide-control": [
        "../../packages/suluu/src/slide-control/index.ts"
      ],
      "suluu/spotlight-card": [
        "../../packages/suluu/src/spotlight-card/index.ts"
      ],
      "suluu/switch-toggle": [
        "../../packages/suluu/src/switch-toggle/index.ts"
      ],
      "suluu/theme-toggle": ["../../packages/suluu/src/theme-toggle/index.ts"],
      "suluu/toast": ["../../packages/suluu/src/toast/index.ts"]
    }
  },
  "include": ["next-env.d.ts", ".next/types/**/*.ts", "**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"]
}
